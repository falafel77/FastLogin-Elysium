```gitignore
# Dependencies
target/

# Logs and temp files
*.log
*.tmp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Build artifacts (common in Java/Maven projects)
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Test reports
test-results/
surefire-reports/

# Original rules preserved
*.log
```